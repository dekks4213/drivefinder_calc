# Telegram
TELEGRAM_BOT_TOKEN=
# Ограничить бота одним пользователем (твой numeric id), необязательно
OWNER_TELEGRAM_ID=

# Gemini
GEMINI_API_KEY=
COACH_MODEL=gemini-flash-latest
# Запасная модель: у неё своя дневная квота, бот уходит на неё при 429
COACH_MODEL_FALLBACK=gemini-pro-latest
COACH_THINKING=LOW
# normal / hard / brutal — интенсивность тона, границы персоны одинаковы на всех
COACH_HARSHNESS=hard

# Прочее
BOT_TZ=Asia/Vladivostok
BOT_DB_PATH=./data/coach.db
REMINDER_EVENING=0 19 * * *
REMINDER_NIGHT=30 22 * * *

# Утро / вечер / ночь
REMINDER_MORNING=30 8 * * *

# Воскресный разбор недели
REMINDER_WEEKLY=0 20 * * 0

# Потолки расхода
USER_DAILY_MESSAGES=80
DAILY_COST_LIMIT_USD=3
BACKUP_CRON=15 4 * * *
BACKUP_KEEP=14
